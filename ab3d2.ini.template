# Alien Breed 3D II: The Killing Grounds - desktop settings
#
# This file is copied to ab3d2.ini beside the executable on the first build.
# Later builds leave your ab3d2.ini untouched. Boolean values accept
# 0/1, false/true, no/yes, or off/on.

# Graphics backend. OpenGL is the implemented desktop and WebGL backend.
# The rtx value uses the opt-in Windows Phase 2 D3D12/DXR diagnostic build.
# Other builds exit explicitly rather than silently substituting OpenGL.
renderer=opengl

# Campaign level A through P, written one-indexed.
start_level=1

# PC convenience options. They are off by default and do not alter source assets.
infinite_health=0
infinite_ammo=0
all_weapons=0
all_keys=0

# 1 = enable F5 quicksave and F9 quickload to/from savegame.bin.
# 0 = ignore those shortcuts. Disabled by default, matching the first port.
quicksave_load=0

# 1 = restore savegame.bin at startup and enter gameplay immediately, skipping
# the initial level flavour text. A missing or invalid save is a startup error.
load_autosave=0

# Master SDL mixer volume, from 0 (silent) through 100.
volume=100

# Run by default; hold Shift to walk. run_default is also accepted for parity
# with the first port's INI.
always_run=1

# Presentation-only subdivisions per source world edge. 1 keeps the strict
# source mesh; 2, 4, and 8 reconstruct progressively smoother light gradients.
world_light_tessellation=4

# --- Ray-traced backend (renderer=rtx) ------------------------------------
# Presentation-only quality settings. Every one of them is commented out, and a
# commented-out key keeps the renderer's own default, so uncomment only what you
# want to change. These do not touch source assets or gameplay.

# Fresh primary direct-light samples per pixel per frame, 1 through 8. Default 1.
#rtx_samples_per_pixel=1

# Maximum fresh diffuse-indirect paths per pixel per frame, 1 through 32. These
# do not repeat primary direct-light shadow rays. Production reconstruction uses
# the maximum for missing, disoccluded, immature, or confirmed-changing history,
# then rotates one path through each 2x2 block of stable pixels while the other
# three reproject validated history. Raw and ReSTIR diagnostics keep a fixed count.
#rtx_indirect_samples=4

# Secondary diffuse-light transfer, 0 through 1. Default 0.75. Zero disables
# diffuse GI and its ReGIR/temporal/spatial work; direct light and visible
# emission remain active. Use rtx_indirect_samples separately to change ray cost.
#rtx_diffuse_gi=0.75

# Path length counting the primary hit, 1 through 8. 1 is direct lighting only.
# Each further bounce adds its own shadow and continuation rays. Default 3.
#rtx_max_bounces=3

# DLSS Ray Reconstruction mode: quality, balanced, performance,
# ultra-performance, or off. This also sets the resolution the path tracer
# renders at before reconstruction. Ultra Performance is explicitly speed-first:
# at a 1280x720 window it traces 285x160, reconstructs to 854x480, then uses the
# final linear presentation upscale. The other enabled modes reconstruct
# directly to the window extent. Default quality.
#rtx_ray_reconstruction=quality

# Display output: sdr uses exact 8-bit sRGB; hdr requires native FP16 scRGB and
# fails clearly if Windows HDR is unavailable; auto explicitly follows the
# current monitor's Windows advanced-colour state. Q2RTX makes HDR opt-in, so
# the matching default is sdr. Hidden GPU smoke is always forced SDR.
#rtx_output=sdr

# Q2RTX-compatible HDR scene controls. Scene EV 0 maps to 800 nits by default,
# and saturation is unchanged at 100%. Peak accepts 100 through 2000 nits;
# saturation accepts 0 through 200%. UI brightness will accompany the pending
# DXR HUD/text implementation instead of exposing a setting that has no pixels.
#rtx_hdr_peak_nits=800
#rtx_hdr_saturation=100

# Fresh emitter candidates drawn at each diffuse vertex, 1 through 1024. The
# primary vertex uses the complete alias table; the indirect vertex uses a
# quantized world-stable local ReGIR proposal. The retained limit caps the validated
# temporal history of the separate diffuse-indirect reconstruction. Defaults
# 16 candidates and 32 effective history samples; zero disables accumulation.
#rtx_light_candidates=16
#rtx_reservoir_limit=32

# Diagnostic ceiling on one sample's luminance. Q2RTX does not clamp path
# radiance, so the matching default is 0 (disabled). Accepts 0 through 100000.
#rtx_radiance_clamp=0

# Q2RTX-compatible post-tone-curve exposure bias, -5 through 0 EV. Default -1.
#rtx_exposure_bias=-1

# GGX visible-normal sampling trim, 0.1 through 1. Default 0.9.
#rtx_ndf_trim=0.9
