# Alien Breed 3D II: The Killing Grounds - desktop settings
#
# This file is copied to ab3d2.ini beside the executable on the first build.
# Later builds leave your ab3d2.ini untouched. Boolean values accept
# 0/1, false/true, no/yes, or off/on.

# Graphics backend. OpenGL is the implemented desktop and WebGL backend.
# The rtx value uses the opt-in Windows Phase 2 D3D12/DXR diagnostic build.
# Other builds exit explicitly rather than silently substituting OpenGL.
renderer=opengl

# Campaign level A through P, written one-indexed.
start_level=1

# PC convenience options. They are off by default and do not alter source assets.
infinite_health=0
infinite_ammo=0
all_weapons=0
all_keys=0

# 1 = enable F5 quicksave and F9 quickload to/from savegame.bin.
# 0 = ignore those shortcuts. Disabled by default, matching the first port.
quicksave_load=0

# 1 = restore savegame.bin at startup and enter gameplay immediately, skipping
# the initial level flavour text. A missing or invalid save is a startup error.
load_autosave=0

# Master SDL mixer volume, from 0 (silent) through 100.
volume=100

# Run by default; hold Shift to walk. run_default is also accepted for parity
# with the first port's INI.
always_run=1

# Presentation-only subdivisions per source world edge. 1 keeps the strict
# source mesh; 2, 4, and 8 reconstruct progressively smoother light gradients.
world_light_tessellation=4

# --- Ray-traced backend (renderer=rtx) ------------------------------------
#
# Presentation-only quality settings. All but rtx_max_luminance are commented
# out, and a commented-out key keeps the renderer's own default, so uncomment
# only what you want to change. These do not touch source assets or gameplay.
#
# The frame is built in this order, and after the resolution it all runs at,
# the sections below follow it:
#
#   primary rays -> path tracing -> ReSTIR PT resampling -> reconstruction
#   -> DLSS upscaling -> tone mapping -> output
#
# Two temporal systems run in that pipeline and they are deliberately kept
# apart. ReSTIR reuses Monte Carlo path samples at the internal render
# resolution and owns the reservoir history. DLSS reconstructs the image and
# owns the output-resolution image history. Neither reads the other's history.


# --- Resolution and upscaling ---------------------------------------------

# DLSS mode, which also fixes the internal resolution the path tracer, the
# G-buffer and every ReSTIR reservoir buffer run at: quality, balanced,
# performance, high-performance, ultra-performance, extreme-performance, or
# off. Changing it resizes those buffers and resets ReSTIR's temporal history
# for a frame. It does not change the estimator: target functions, PDFs and
# path transport are identical at every mode. Default quality.
#
# Share of the window's pixels traced, that size at 3838x2158, and the GPU time
# a frame took there on an RTX 3090:
#
#   quality              44%  2559x1439  88 ms
#   balanced             34%  2226x1252  66 ms
#   performance          25%  1919x1079  49 ms
#   high-performance     20%  1716x965   40 ms
#   ultra-performance    11%  1279x719   24 ms
#   extreme-performance   5%   853x480   12 ms
#
# Quality through ultra-performance are NVIDIA's own sizes, and each but
# high-performance reconstructs straight to the window. No DLSS mode can reach
# the window from a buffer between Performance's and Ultra Performance's, so
# high-performance reconstructs to twice its size, and extreme-performance
# takes Ultra Performance's third to two thirds of the window; the
# presentation's linear upscale covers the rest.
#
# Ray Reconstruction is the denoiser whenever DLSS runs; off renders without
# one. rtx_ray_reconstruction is accepted as an older spelling of this key.
#rtx_dlss=quality

# What the DLSS pass's input is multiplied by, 1 through 1024. Its output is
# divided by the same factor before bloom and tone mapping, so this changes
# only the units DLSS works in: nothing is clamped or discarded. Default 32.
#
# Ray Reconstruction is not scale invariant. A room lit only through a doorway
# sits around 0.00015 in scene radiance, and at that absolute level RR turns it
# into blotches and sparkles -- but only while something bright is on screen.
# Turn away from the doorway and the same room denoises cleanly. Measured on
# such a room with the doorway in view: 4 is still blotchy, 12.5 partly clean,
# 32 and 64 clean. The renderer lowers it automatically wherever the scene's
# brightest emitter would otherwise overflow RR's half-float input, so a high
# rtx_light_scale is safe. 1 restores the unscaled input. It does nothing
# while DLSS is off.
#rtx_rr_input_scale=32


# --- Path tracer ----------------------------------------------------------

# Path length counting the primary hit, 1 through 8. 1 is direct lighting only.
# Each further bounce adds its own shadow and continuation rays. Default 3.
#rtx_max_bounces=3

# Fresh primary direct-light samples per pixel per frame, 1 through 8. Default 1.
#rtx_samples_per_pixel=1

# Fresh indirect paths per internal pixel per frame, 1 through 32. Default 4.
# The most expensive setting there is: at 3838x2158 with rtx_dlss=performance
# four paths take 21.5 ms of the frame and one takes 9. ReSTIR PT is built
# around one new path per pixel, but with fewer it currently reads darker --
# 3% at four against plain path tracing and 8% at one.
#rtx_indirect_samples=4

# Probability that a path's first bounce is aimed through one of its zone's
# openings rather than drawn from the cosine distribution, 0 through 0.9.
# Default 0.5.
#
# A room lit only through a doorway gets all of its light from the bounce rays
# that happen to leave through it. The rest find nothing, so the room is a few
# very bright samples on black, and each of them reads as a firefly that the
# denoiser smears into a blotch. The level already knows its openings -- every
# EdgeT that joins one zone to another -- so a share of first bounces is aimed
# at those whose far side can see a light.
#
# It is unbiased: both proposals form one mixture, and each path is weighted by
# the cosine density over the mixture's density in its direction. Measured on
# a doorway-lit room before any denoising, the room's mean bounce light is
# unchanged within a standard error and its frame-to-frame noise halves. 0.75
# began to flicker on the same room, and it costs about 0.36 ms a frame at
# 640x360 on an RTX 3090. It stops short of 1 because the cosine share is what
# keeps every direction reachable; 0 is plain cosine sampling.
#rtx_portal_sampling=0.5

# Fresh emitter candidates drawn at each diffuse vertex, 1 through 1024. The
# primary vertex draws from every light in the level; a bounce vertex draws from
# the lights its zone can see, falling back to a world-stable local grid where
# the zone has none. Default 16.
#rtx_light_candidates=16

# Maximum polygon-light RIS estimates for one rotating diffuse path stratum.
# Default 2 applies that extra estimate coherently every third frame, partitions
# the stratum's candidate budget into two disjoint groups, and averages their
# fresh visibility results. Use 1 as the lower-cost control.
#rtx_indirect_light_samples=2

# Roughness at which specular stops being traced and is reconstructed from the
# filtered diffuse signal instead. Reconstruction is much cheaper but carries no
# directional detail, so a surface above this limit cannot mirror the scene.
# World surfaces sit around 0.44 to 0.72, so the default leaves all of them
# reconstructed. 0.3 through 1. Default 0.3.
#rtx_specular_roughness=0.3

# GGX visible-normal sampling trim, 0.1 through 1. Default 0.9.
#rtx_ndf_trim=0.9

# Ceiling on one lighting sample, applied to direct, specular and each indirect
# bounce, 0 through 100000. Default 0, off.
#
# Q2RTX's clamp_output() bounds every lighting result to 1000, its
# MAX_OUTPUT_VALUE. This renderer does not by default: a clamp removes the
# energy of the paths it cuts rather than estimating them better, so it darkens
# the image where it acts. Any nonzero value also turns off the split primary
# scheduler, which assumes an unclamped signal.
#rtx_radiance_clamp=0

# Multiplies every material's authored emissive factor, 0 through 1024.
# Default 1, the level as authored.
#
# One control over the whole level's light rather than a per-material edit:
# the relationship between the lights stays as the artist set it and only the
# overall level moves. It scales what the lights radiate and what next-event
# estimation samples them as together, so a light stays as bright as it looks.
#
# Raising it forces more light into the scene and pushes exposure down to
# compensate, so rtx_max_luminance below has to have the range for it.
#rtx_light_scale=1.0

# Radiance of a fully lit surface under the level's own vertex lighting,
# 0 through 1024. Default 0, which is pure path-traced indirect.
#
# Alien Breed 3D II lights every surface from its sector brightness tables, not
# from the emissive fixtures a path tracer can see: no palette entry in the game
# survives the darkest shading row, so no texture is self-lit. The renderer uses
# those tables from the second bounce onward. The primary hit stays fully path
# traced -- emitters, ray-traced shadows, the lot -- and a ray that bounces onto
# a surface reads its vertex lighting rather than spending the rays needed to
# light it properly.
#
# Dark parts of a level are lit almost entirely through those bounces, which is
# where a path tracer has the least signal and so the most grain. Raising this
# lifts them further out of the noise; lowering it returns to a darker, more
# physically literal image lit only by what emits.
#
# The unit is scene radiance, so read it against what the level emits:
# floor_0101 emits 164 and the wall fixtures 1.5 to 7.7. One is about a 160th
# of the brightest thing in frame and looks identical to zero. Measured on a
# saved game, the tenth percentile of the frame runs 11 at zero, 16 at 8, 19 at
# 64 and 20 at 128, and highlights begin to clip past 128, so the useful range
# is 64 to 128.
#
# It is off by default. It lifts the dark end of the frame, but it did not fix
# the grain around a bright fixture that it was built for.
#rtx_bounce_light=0.0


# --- ReSTIR PT ------------------------------------------------------------
#
# ReSTIR PT resamples whole light paths between neighbouring pixels and between
# frames, so a good path found anywhere on screen can be reused everywhere it is
# valid. It runs entirely at the internal render resolution, before any
# upscaling, and never reads a reconstructed image.

# Which estimator produces indirect lighting.
#   restir-pt   ReSTIR PT Enhanced spatiotemporal path resampling. This is what
#               the renderer runs.
#   path-trace  Independent fresh paths every frame, no reservoir reuse. Slower
#               to converge, and kept as the reference the resampled estimator
#               is validated against rather than as a quality setting.
# Default restir-pt.
#rtx_indirect_mode=restir-pt

# Cap on a reservoir's represented sample count M, 1 through 64. Default 20.
# A reservoir that survives reuse raises M every frame, and the cap bounds how
# long one path may keep speaking for a pixel. Set it to 1 to disable temporal
# reuse while leaving spatial resampling active, which is the first thing to try
# when diagnosing a lighting trail or a persistent firefly.
#rtx_restir_temporal_history=20

# Spatial neighbours resampled per pixel, 0 through 8. Default 2. Zero disables
# spatial reuse. Each neighbour costs a shift and its reverse, both traced.
#rtx_restir_spatial_samples=2

# Spatial search radius as a fraction of render height, 0 through 0.25.
# Default 0.03. Deliberately not a pixel count: a fixed 8-pixel radius covers
# very different amounts of the image at Quality and at Ultra Performance, so
# expressing it relative to render height keeps the search footprint stable when
# rtx_dlss changes.
#rtx_restir_spatial_radius=0.03

# Duplication-based history reduction strength, 0 through 4. Default 0, off.
# Where one canonical path has been copied across many reservoirs, those
# descendants are not independent samples. This counts how many neighbours
# share a sample ancestry and lowers the temporal cap toward 1 as that
# duplication rises; the value is the exponent of the curve.
#
# It is off because it is biased. The samples that spread are the bright ones
# resampling favours, so lowering confidence where they have spread lowers the
# weight of exactly those samples: a doorway-lit room read 11% dark at the
# default reuse and 17% at 64 frames and 4 neighbours.
#rtx_restir_history_reduction=0

# Probability that final shading discards the resampled reservoir and shades the
# preserved initial sample instead, 0 through 1. Default 0, off.
#
# Ray Reconstruction expects temporally independent input noise, and ReSTIR
# correlates samples across frames on purpose. This trades some of that reuse
# back for independence. The probability is fixed: it used to be scaled by how
# long a pixel had held its sample, but the long-lived samples are the bright
# winners resampling favours, so that replaced exactly those and darkened the
# image in proportion to the history length. Once the estimator itself was
# unbiased, ReSTIR without decorrelation measured as free of sparkle after RR
# as plain path tracing. Only meaningful while DLSS is on.
#rtx_restir_decorrelation=0


# --- Tone mapping and output ----------------------------------------------

# Where the tone curve stops treating a luminance as signal, in photographic
# stops, -24 through 0. Default 0.
#
# This is Q2RTX's tm_noise_stops. Below this value the curve flattens towards
# a plain exposure line instead of stretching the histogram, so regions the
# path tracer only has noise for read dark rather than showing their grain.
# It is the control for "that corner should be too dark to see the static in".
#
# Q2RTX ships -12, calibrated to Q2RTX's own light levels, and at -12 this
# game's frames contain no true black at all once anything clips: the dark
# half of the image lifts into a flat featureless band with the path tracer's
# residual wobble on top, which is what reads as static whenever a light is on
# screen. On a clipping view the fraction of the frame below 8 of 255 is 0.0%
# at -12, 20.1% at -10 and 33.0% at -8, with the lit areas unchanged
# throughout.
#
# Zero, the top of the range, is what this game ships. It leaves the histogram
# stretching to luminances above one and puts everything below it on the plain
# exposure line -- the darkest and steadiest setting available. Against -10 the
# frozen frame's temporal outliers go 7 to 0 and the firing frame's 25917 to
# 20386, with 47% of the frame reading below 8 of 255 and the lit surfaces
# untouched.
#
# Lower it to lift the dark end of the image back up, at the cost of showing
# more of what the path tracer is unsure about there.
#rtx_noise_floor=0.0

# The darkest scene luminance auto-exposure will meter to, 0.000001 through 1.
# Default 0.01.
#
# This is Q2RTX's tm_min_luminance, and it is also the cap on how far exposure
# can open up, because the gain it produces is 0.125 divided by this: 0.01
# permits 12.5x.
#
# Q2RTX ships 0.0002, which permits 625x. A view of this game's dark geometry
# meters around 0.0036 and asks for 34x, and at that gain the path tracer's
# noise is amplified along with everything else. Worse, exposure needs seconds
# to travel that far, so while the player turns it is always mid-ramp and the
# dark end drifts upward frame after frame, undoing rtx_noise_floor above.
#
# Measured against 0.0002 on that view: true black rises from 24.6% to 37.5%
# of the frame, noise amplitude in the dark regions falls from 9.4 to 7.9, and
# the clipped fraction is unchanged at 8.2% -- the lights are untouched and
# only the amplification of the darks has gone. Lower it to let dark rooms
# brighten further at the cost of that amplification.
#rtx_min_luminance=0.01

# The brightest scene luminance auto-exposure will meter to, 0.001 through
# 1024. Default 16.
#
# This is Q2RTX's tm_max_luminance, and it is the floor on exposure gain: the
# gain is 0.125 divided by this, so 16 bottoms out at 0.0078.
#
# Q2RTX ships 1.0, which bottoms out at 0.125. This game's emitters are
# authored far above Q2RTX's -- the floor light and the techno lights both sit
# at 1600 -- and a view of them meters around 8.7, eight times past that
# clamp. Exposure then sits pinned with nowhere to go and the frame blows out:
# measured on a clipping view, 129344 pixels saturated at 1.0 against none at
# 16, with the frame mean falling 68.5 to 46.2. At 16 the clamp stops binding
# for this content, and 64 measures identically, so there is no reason to go
# higher.
#
# Lower it to force a bright scene to keep reading bright.
#
# This file sets 1024 so that a raised rtx_light_scale above has room. With the
# level's own lights the meter stays under 16, where the two read the same.
rtx_max_luminance=1024.0

# Q2RTX-compatible post-tone-curve exposure bias, -5 through 0 EV. Default -1.
# This is applied downstream of the estimator on purpose: changing exposure must
# not change which light path is statistically important, so it never reaches a
# ReSTIR target function.
#rtx_exposure_bias=-1

# Display output: sdr uses exact 8-bit sRGB; hdr requires native FP16 scRGB and
# fails clearly if Windows HDR is unavailable; auto explicitly follows the
# current monitor's Windows advanced-colour state. Q2RTX makes HDR opt-in, so
# the matching default is sdr. Hidden GPU smoke is always forced SDR.
#rtx_output=sdr

# Q2RTX-compatible HDR scene controls. Scene EV 0 maps to 800 nits by default,
# and saturation is unchanged at 100%. Peak accepts 100 through 2000 nits;
# saturation accepts 0 through 200%.
#rtx_hdr_peak_nits=800
#rtx_hdr_saturation=100
